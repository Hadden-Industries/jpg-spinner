# EditorConfig gives every supported editor the same repository-wide text
# contract. C++ identifier cases are enforced separately by .clang-tidy because
# Visual Studio does not define C++ naming keys in its EditorConfig surface.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# Preserve tabs where the file format assigns them semantic meaning.
[Makefile]
indent_style = tab

# Keep Markdown's intentional hard line breaks while normalizing all other
# repository text through the common rules above.
[*.md]
trim_trailing_whitespace = false
