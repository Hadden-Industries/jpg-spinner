<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- UIA uses physical coordinates. Establish the test host's DPI context at
       process creation so native window measurements and resize requests are
       not silently virtualized. Windows 11 is the supported test platform.
       https://learn.microsoft.com/windows/win32/hidpi/setting-the-default-dpi-awareness-for-a-process -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- The packaged worker consumes the shipping storage adapter. Match
           its process-creation policy without altering machine settings. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
