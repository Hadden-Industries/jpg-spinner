<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear user/machine feeds so dependency resolution cannot vary by host. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    NuGet merges each collection independently. Clear an inherited disabled
    state as well as inherited source definitions so nuget.org remains usable.
  -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <!-- Every package ID is constrained to the sole reviewed HTTPS source. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
