<Project>
  <!--
    Directory.Build.props is imported early. Keep only selection properties
    here; compiler and linker item metadata belongs in Directory.Build.targets,
    after Microsoft.Cpp.props has defined the relevant item types.
  -->
  <PropertyGroup>
    <!--
      All maintained C++ projects participate by default. Keep selection
      properties and late item metadata on the same participation boundary;
      effective-build checks verify the actual compiler/linker invocation.
    -->
    <JpgSpinnerModernCppBuildPolicyEnabled
      Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == ''">true</JpgSpinnerModernCppBuildPolicyEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == 'true'">
    <PlatformToolset>v145</PlatformToolset>
    <VCToolsVersion>14.51.36231</VCToolsVersion>
    <!-- Select the installed 64-bit host tools consistently for every target. -->
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <!--
      Keep VC include and library directories under MSBuild/toolset control.
      UseEnv=true would replace those evaluated directories with unreviewed
      INCLUDE, LIB, LIBPATH, and PATH values inherited from the calling shell.
    -->
    <UseEnv>false</UseEnv>
    <!-- Native library macros become available in Microsoft.Cpp.props. Import
         the shared base immediately afterward, before a project's ASan/Fuzz
         extensions append their required libraries. This is Microsoft's C++
         customization hook, not an installed SDK edit or a late reset.
         https://learn.microsoft.com/visualstudio/msbuild/customize-cpp-builds -->
    <ForceImportAfterCppProps>$(MSBuildThisFileDirectory)eng\NativeLibraryDirectories.props</ForceImportAfterCppProps>
    <!--
      Use MSBuild's structured property rather than a raw /Qspectre token. In
      addition to compiler instrumentation, this selects the installed,
      architecture-specific Spectre-mitigated MSVC runtime libraries.
    -->
    <SpectreMitigation>Spectre</SpectreMitigation>
    <WindowsTargetPlatformMinVersion>10.0.19045.0</WindowsTargetPlatformMinVersion>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <!-- The Store package supplies identity and framework dependencies. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!--
      Visual Studio 2026 ships native vcxproj PackageReference support behind
      this explicit opt-in. Enabling the project-system implementation is what
      makes restore and build consume the same native dependency graph; do not
      recreate that integration with package imports or compatibility targets.
    -->
    <EnableNativePackageReferenceSupport>true</EnableNativePackageReferenceSupport>

    <!--
      Use the vcpkg bundled with the selected Visual Studio instance. Explicit
      repository imports avoid mutable user-wide `vcpkg integrate install`
      state while retaining vcpkg's supported MSBuild integration targets.
    -->
    <VcpkgRoot>$(VsInstallRoot)\VC\vcpkg\</VcpkgRoot>
    <VcpkgEnableClassic>false</VcpkgEnableClassic>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>true</VcpkgManifestInstall>
    <!-- The bundled executable must already exist; never mutate the selected Visual Studio installation by bootstrapping. -->
    <VcpkgAutoBootstrap>false</VcpkgAutoBootstrap>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <!-- Every reviewed dependency is static, so app-local DLL discovery is unnecessary. -->
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
    <!-- Select only repository-owned triplets whose executed CMake command streams are policy-verified. -->
    <VcpkgAdditionalInstallOptions>--overlay-triplets="$(MSBuildThisFileDirectory)vcpkg-triplets"</VcpkgAdditionalInstallOptions>
    <VcpkgTriplet Condition="'$(Platform)' == 'Win32'">x86-windows-static-md</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Platform)' == 'x64' and '$(EnableASAN)' != 'true'">x64-windows-static-md</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Platform)' == 'x64' and '$(EnableASAN)' == 'true'">x64-windows-static-md-asan</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Platform)' == 'ARM64'">arm64-windows-static-md</VcpkgTriplet>
  </PropertyGroup>

  <Import
    Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props"
    Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == 'true' and '$(VcpkgEnabled)' != 'false'" />
</Project>
