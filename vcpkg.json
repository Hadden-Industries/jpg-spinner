{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "jpg-spinner",
    "version-string": "2.0.0",
    "builtin-baseline": "8f0be20f53767f13f27aea63d64d98990965fb1d",
    "configuration": {
        "overlay-ports": ["vcpkg-ports/adobe-xmp-core", "vcpkg-ports/exiv2", "vcpkg-ports/catch2", "vcpkg-ports/zlib"]
    },
    "dependencies": [
        {
            "name": "libjpeg-turbo",
            "default-features": false
        },
        {
            "name": "exiv2",
            "default-features": false,
            "features": ["xmp"]
        },
        {
            "name": "catch2",
            "default-features": false
        }
    ],
    "overrides": [
        {
            "name": "adobe-xmp-core",
            "version": "2025.03#3"
        },
        {
            "name": "libjpeg-turbo",
            "version": "3.2.1"
        },
        {
            "name": "exiv2",
            "version": "0.28.9#3"
        },
        {
            "name": "catch2",
            "version": "3.16.1#1"
        },
        {
            "name": "zlib",
            "version": "1.4#1"
        }
    ]
}
