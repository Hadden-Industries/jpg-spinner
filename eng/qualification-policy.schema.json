{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Versioned qualification policy and generated-consumer bindings",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "timeoutSeconds",
        "artifactPolicy",
        "cppPollingMilliseconds",
        "workflowJobCategories",
        "workflowStepCategories",
        "cppTimeoutCategories"
    ],
    "$defs": {
        "category": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "categoryBindings": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "type": "string", "minLength": 1, "maxLength": 160 },
            "additionalProperties": { "$ref": "#/$defs/category" }
        }
    },
    "properties": {
        "schemaVersion": { "const": 1 },
        "timeoutSeconds": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/category" },
            "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 2147483 }
        },
        "artifactPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["retentionDays", "compressionLevel"],
            "properties": {
                "retentionDays": { "type": "integer", "minimum": 1, "maximum": 90 },
                "compressionLevel": { "type": "integer", "minimum": 0, "maximum": 9 }
            }
        },
        "cppPollingMilliseconds": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/category" },
            "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 60000 }
        },
        "workflowJobCategories": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z0-9-]+\\.yml$" },
            "additionalProperties": { "$ref": "#/$defs/categoryBindings" }
        },
        "workflowStepCategories": { "$ref": "#/$defs/categoryBindings" },
        "cppTimeoutCategories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/category" }
        }
    }
}
