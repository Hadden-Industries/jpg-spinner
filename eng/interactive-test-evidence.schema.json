{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automated UI execution evidence; not operator acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "sourceCommit", "sourceRunId", "qualificationRunId", "inputContextSha256", "junitSha256", "startedAt", "completedAt", "assertionCount", "reportedCaseCount", "requestedTestSpecification", "operatorAcceptance"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runId": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"}
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "scope": {"const": "automated-ui-only"},
    "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sourceRunId": {"$ref": "#/$defs/runId"},
    "qualificationRunId": {"$ref": "#/$defs/runId"},
    "inputContextSha256": {"$ref": "#/$defs/sha256"},
    "junitSha256": {"$ref": "#/$defs/sha256"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "assertionCount": {"type": "integer", "minimum": 1},
    "reportedCaseCount": {"type": "integer", "minimum": 1},
    "requestedTestSpecification": {"const": "[ui-automation]~[operator-assisted]"},
    "operatorAcceptance": {"const": "pending"}
  }
}
