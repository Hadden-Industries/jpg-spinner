<Project>
  <Target Name="JpgSpinnerValidateNativeLibraryDirectories"
          BeforeTargets="SetBuildDefaultEnvironmentVariables"
          Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == 'true'">
    <!-- MSBuild owns list expansion/batching. A missing required installation
         is a hard error, never an invitation to remove an input or fall back. -->
    <ItemGroup>
      <JpgSpinnerNativeLibraryDirectory Include="$(LibraryPath)" />
    </ItemGroup>
    <Error Condition="'@(JpgSpinnerNativeLibraryDirectory)' == ''"
           Text="Required native library directory selection is empty." />
    <Error Condition="!$([System.IO.Directory]::Exists('%(JpgSpinnerNativeLibraryDirectory.Identity)'))"
           Text="Required native library directory is absent or not a directory: %(JpgSpinnerNativeLibraryDirectory.Identity)" />
  </Target>

  <!--
    These item definitions are evaluated after Microsoft.Cpp.props so they map
    to real CL and LINK task parameters instead of becoming inert properties.
    Every group honors the project-level modern-policy boundary established in
    Directory.Build.props. All maintained C++ projects participate.
    Effective command lines and x64 PE metadata are verified independently by
    scripts/Test-EffectiveBuildPolicy.ps1.
  -->
  <ItemDefinitionGroup
    Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == 'true'">
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /guard:cf /Brepro %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/guard:cf /Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup
    Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == 'true' and '$(Configuration)' == 'Debug'">
    <ClCompile>
      <!-- /ZI is incompatible with Control Flow Guard; /Zi retains PDBs. -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup
    Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == 'true' and '$(Configuration)' == 'Release'">
    <ClCompile>
      <!-- Keep /O2 explicit so Release behavior cannot drift with imported defaults. -->
      <Optimization>MaxSpeed</Optimization>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <!-- Optional C++/WinRT error-origin data embeds clone-local source paths.
           Use the documented configuration consistently across all files and
           static libraries in a Release module, before projection headers.
           HRESULTs, application diagnostics and PDB symbols remain; Debug keeps
           source origins. This does not omit or rewrite any WinMD metadata.
           https://learn.microsoft.com/windows/apps/develop/cpp-winrt/macros#winrt_no_source_location -->
      <PreprocessorDefinitions>WINRT_NO_SOURCE_LOCATION;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <!-- Keep the actual PDB in OutDir, but embed only its filename in the
           release image. LINK expands its own %_PDB% variable; do not expand
           it in a shell or replace it with a workstation-specific path.
           This removes one cross-root input without claiming the MIDL/XAML
           toolchain or the remaining binary contents are reproducible.
           https://learn.microsoft.com/cpp/build/reference/pdbaltpath-use-alternate-pdb-path -->
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <!-- Intel CET shadow-stack compatibility is a final-image x64 contract. -->
  <ItemDefinitionGroup
    Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == 'true' and '$(Platform)' == 'x64'">
    <Link>
      <AdditionalOptions>/CETCOMPAT %(AdditionalOptions)</AdditionalOptions>
      <!-- Frozen x64 LINK inputs produced different instruction bytes with
           identical COMDAT folding, even at one LTCG thread. The documented
           NOICF control produces identical native replay images. Disable only
           this folding for x64 Release: retain /O2, LTCG, reference elimination,
           symbols, security mitigations and ordinary build parallelism. Full
           application/package comparison remains a separate acceptance gate.
           https://learn.microsoft.com/cpp/build/reference/opt-optimizations -->
      <EnableCOMDATFolding Condition="'$(Configuration)' == 'Release'">false</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>

  <Import
    Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets"
    Condition="'$(JpgSpinnerModernCppBuildPolicyEnabled)' == 'true' and '$(VcpkgEnabled)' != 'false'" />
</Project>
