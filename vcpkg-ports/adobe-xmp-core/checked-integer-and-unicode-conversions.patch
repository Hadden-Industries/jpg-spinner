 // ConvertToInt
 // ------------
 
+// The public integer APIs accept decimal values and hexadecimal bit patterns.
+// scanf does not provide an overflow-safe conversion contract. Use the native
+// checked conversions, retain complete-input validation and preserve the SDK's
+// existing signed hexadecimal representation without pointer aliasing.
+template <typename SignedInteger>
+static SignedInteger ConvertToSignedInteger ( XMP_StringPtr strValue )
+{
+    static_assert ( std::is_signed_v<SignedInteger> );
+    using UnsignedInteger = std::make_unsigned_t<SignedInteger>;
+    if ( (strValue == 0) || (*strValue == 0) ) XMP_Throw ( "Empty convert-from string", kXMPErr_BadValue );
+
+    char * conversionEnd = nullptr;
+    errno = 0;
+    if ( XMP_LitNMatch ( strValue, "0x", 2 ) ) {
+        const auto value = std::strtoumax ( strValue, &conversionEnd, 16 );
+        if ( (errno == ERANGE) || (conversionEnd == strValue) || (*conversionEnd != 0) ||
+             (value > (std::numeric_limits<UnsignedInteger>::max)()) )
+            XMP_Throw ( "Invalid integer string", kXMPErr_BadParam );
+        return std::bit_cast<SignedInteger> ( static_cast<UnsignedInteger>(value) );
+    }
+
+    const auto value = std::strtoimax ( strValue, &conversionEnd, 10 );
+    if ( (errno == ERANGE) || (conversionEnd == strValue) || (*conversionEnd != 0) ||
+         (value < (std::numeric_limits<SignedInteger>::min)()) ||
+         (value > (std::numeric_limits<SignedInteger>::max)()) )
+        XMP_Throw ( "Invalid integer string", kXMPErr_BadParam );
+    return static_cast<SignedInteger>(value);
+}
+
 /* class static */ XMP_Int32
 XMPUtils::ConvertToInt ( XMP_StringPtr strValue )
 {
-	if ( (strValue == 0) || (*strValue == 0) ) XMP_Throw ( "Empty convert-from string", kXMPErr_BadValue );
-
-	int count;
-	char nextCh;
-	XMP_Int32 result;
-
-	if ( ! XMP_LitNMatch ( strValue, "0x", 2 ) ) {
-		count = sscanf ( strValue, "%d%c", &result, &nextCh );
-	} else {
-		count = sscanf ( strValue, "%x%c", &result, &nextCh );
-	}
-
-	if ( count != 1 ) XMP_Throw ( "Invalid integer string", kXMPErr_BadParam );
-
-	return result;
-
-}	// ConvertToInt
+    return ConvertToSignedInteger<XMP_Int32> ( strValue );
+} // ConvertToInt
 
