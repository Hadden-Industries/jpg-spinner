<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="uap uap10">
  <Identity Name="HaddenIndustriesLtd.JPGSpinner" Publisher="CN=42458E53-5B1F-4F49-97F4-ABE6B4A48BB3" Version="2.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="19A75C42-E5BA-44A4-862F-7B7B77AC9BC7" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>JPG Spinner</DisplayName>
    <PublisherDisplayName>Hadden Industries Ltd</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19045.0" MaxVersionTested="10.0.28000.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="en-GB" />
    <Resource Language="ru" />
  </Resources>
  <Applications>
    <!-- Windows 10 2004+ expresses desktop runtime and trust independently.
         Package identity alone does not supply the AppContainer boundary.
         https://learn.microsoft.com/windows/msix/msix-container -->
    <Application Id="App" Executable="$targetnametoken$.exe"
                 uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="appContainer">
      <uap:VisualElements
        DisplayName="JPG Spinner"
        Description="Lossless JPEG orientation and metadata processing"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <!-- Folder access comes from a real picker grant, never a broad capability. -->
  <Capabilities />
</Package>
