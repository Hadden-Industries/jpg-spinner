<Window x:Class="JpgSpinner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:presentation="using:JpgSpinner.Presentation" Title="JPG Spinner">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <!-- Transparent root lets the native backdrop/fallback show through. -->
    <!-- Global history shortcuts are input routes, not content tooltips.
         https://learn.microsoft.com/windows/apps/develop/input/keyboard-accelerators -->
    <Grid x:Name="ShellRoot" Background="Transparent" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <DataTemplate x:Key="SettingsArticleHeaderTemplate">
                <!-- Material belongs to navigation; article text stays on a
                     quiet content surface with native accessibility fallback. -->
                <Grid Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Padding="24,12">
                    <Button x:Uid="Shell_BackToSettings" Click="CloseSettingsHelp_Click" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="BackToSettings" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock x:Uid="Shell_SettingsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="FolderPreferenceHeaderTemplate">
                <Grid ColumnSpacing="12" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SectionIconBadgeStyle}" Background="{ThemeResource JpgSpinnerOrangeIconBackgroundBrush}">
                        <SymbolIcon Symbol="Folder" Foreground="{ThemeResource JpgSpinnerOrangeTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="OutputPreferenceHeaderTemplate">
                <Grid ColumnSpacing="12" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SectionIconBadgeStyle}" Background="{ThemeResource JpgSpinnerVioletIconBackgroundBrush}">
                        <SymbolIcon Symbol="Save" Foreground="{ThemeResource JpgSpinnerVioletTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="EdgeTrimmingPreferenceHeaderTemplate">
                <Grid ColumnSpacing="12" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SectionIconBadgeStyle}" Background="{ThemeResource JpgSpinnerOrangeIconBackgroundBrush}">
                        <SymbolIcon Symbol="Crop" Foreground="{ThemeResource JpgSpinnerOrangeTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="EncodingPreferenceHeaderTemplate">
                <Grid ColumnSpacing="12" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SectionIconBadgeStyle}" Background="{ThemeResource JpgSpinnerVioletIconBackgroundBrush}">
                        <SymbolIcon Symbol="Pictures" Foreground="{ThemeResource JpgSpinnerVioletTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Menu" Invoked="NavigateBack_Invoked" Key="Left" />
            <KeyboardAccelerator Modifiers="Menu" Invoked="NavigateForward_Invoked" Key="Right" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="JPG Spinner" IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.targetsize-32.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <CommandBar Background="Transparent" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                    <AppBarButton x:Uid="Shell_OpenSettings" Icon="Setting" Click="Settings_Click" AutomationProperties.AutomationId="OpenSettings" />
                </CommandBar>
            </TitleBar.RightHeader>
        </TitleBar>
        <!-- UserControl owns the visual states on its direct content root,
             allowing native adaptive triggers to select the window layout.
             https://learn.microsoft.com/windows/apps/develop/ui/layouts-with-xaml -->
        <!-- Native visual-state hosts retain an adaptive, branded landing page
             without changing the processing state machine. -->
        <!-- Help is packaged locally and remains readable offline. A shared
             native back route returns to Settings without resetting choices. -->
        <Grid Visibility="Collapsed" x:Name="ShellViews">
            <Grid x:Name="WorkflowView">
                <UserControl IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid x:Name="LandingPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Storyboard x:Name="LogoSpin">
                                <DoubleAnimation Storyboard.TargetName="BrandLogoRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="BrandSidebarColumn" Width="2*" MinWidth="240" MaxWidth="360" />
                            <ColumnDefinition Width="8*" x:Name="WorkspaceColumn" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="LandingNarrow">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="BrandSidebarColumn.Width" Value="*" />
                                        <Setter Target="BrandSidebarColumn.MinWidth" Value="0" />
                                        <Setter Target="BrandSidebarColumn.MaxWidth" Value="10000" />
                                        <Setter Target="LandingBackdrop.Visibility" Value="Collapsed" />
                                        <Setter Target="WorkspaceColumn.Width" Value="0" />
                                        <Setter Target="BrandSidebar.(Grid.RowSpan)" Value="1" />
                                        <Setter Target="BrandSidebar.Padding" Value="12" />
                                        <Setter Target="BrandIntro.Orientation" Value="Horizontal" />
                                        <Setter Target="BrandLogoVisual.Width" Value="40" />
                                        <Setter Target="BrandLogoVisual.Height" Value="40" />
                                        <Setter Target="BrandTitle.FontSize" Value="24" />
                                        <Setter Target="BrandFooter.Visibility" Value="Collapsed" />
                                        <Setter Target="WorkflowPanel.(Grid.Column)" Value="0" />
                                        <Setter Target="WorkflowPanel.(Grid.Row)" Value="1" />
                                        <Setter Target="WorkflowPanel.(Grid.RowSpan)" Value="1" />
                                        <Setter Target="WorkflowPanel.Margin" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="LandingWide">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="640" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Background="{ThemeResource JpgSpinnerOrangeBrush}" Padding="24" x:Name="BrandSidebar" Grid.RowSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" x:Name="BrandIntro">
                                <Button x:Uid="Shell_SpinLogo" AutomationProperties.AutomationId="SpinLogo" Click="Logo_Click" Background="Transparent" BorderThickness="0" Padding="12" HorizontalAlignment="Center">
                                    <!-- Keep the logo's Easter egg visually undisclosed. Scoped
                   native brush overrides preserve button/keyboard behaviour
                   and leave every other control's interaction styles intact. -->
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                    </Button.Resources>
                                    <ContentControl Width="100" Height="100" RenderTransformOrigin="0.5,0.5" ContentTemplate="{StaticResource JpgSpinnerLogoTemplate}" Content="logo" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" x:Name="BrandLogoVisual">
                                        <ContentControl.RenderTransform>
                                            <RotateTransform x:Name="BrandLogoRotation" />
                                        </ContentControl.RenderTransform>
                                    </ContentControl>
                                </Button>
                                <TextBlock Text="JPG Spinner" FontSize="28" Foreground="{ThemeResource JpgSpinnerBrandForegroundBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" x:Name="BrandTitle" />
                            </StackPanel>
                            <Button Grid.Row="1" x:Uid="Shell_SourcePicker" AutomationProperties.AutomationId="SourceFolderPicker" Click="SourcePicker_Click" IsEnabled="{x:Bind CanPickSourceFolder, Mode=OneWay}" Foreground="{ThemeResource JpgSpinnerBrandForegroundBrush}" Background="Transparent" BorderBrush="{ThemeResource JpgSpinnerBrandForegroundBrush}" BorderThickness="2" CornerRadius="0" FontSize="20" FontWeight="SemiBold" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Spacing="12" Margin="0,24,0,8" x:Name="BrandFooter">
                                <ProgressRing IsActive="{x:Bind IsStartupRecoveryPending, Mode=OneWay}" Width="24" Height="24" Foreground="{ThemeResource JpgSpinnerBrandForegroundBrush}" />
                                <HyperlinkButton Content="© Hadden Industries Ltd" NavigateUri="https://haddenindustries.com/" Foreground="{ThemeResource JpgSpinnerFooterForegroundBrush}" HorizontalAlignment="Center" ContentTemplate="{StaticResource WrappingTextContentTemplate}" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="LandingBackdrop" Grid.Column="1" Background="{ThemeResource JpgSpinnerPurpleBrush}" Grid.RowSpan="2">
                            <ContentControl Margin="0,96,0,0" Opacity="0.02" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" ContentTemplate="{StaticResource JpgSpinnerLogoTemplate}" Content="logo" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        </Grid>
                        <UserControl IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsEnabled="{x:Bind IsWorkflowInteractionEnabled, Mode=OneWay}" Visibility="{x:Bind WorkflowRegionVisibility, Mode=OneWay}" Grid.Column="1" Grid.RowSpan="2" x:Name="WorkflowPanel" Margin="24">
                            <!-- Keep reading surfaces opaque over the purple artwork;
                                 translucent material belongs to navigation chrome. -->
                            <Grid x:Name="WorkflowContent" Padding="16" RowSpacing="12" MaxWidth="1120" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="WorkspaceCompact">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="OutputSummaryColumn.Width" Value="0" />
                                                <Setter Target="OutputSummaryCard.(Grid.Column)" Value="0" />
                                                <Setter Target="OutputSummaryCard.(Grid.Row)" Value="1" />
                                                <Setter Target="SelectedSourceActionColumn.Width" Value="0" />
                                                <Setter Target="ChangeSourceFolderButton.(Grid.Column)" Value="0" />
                                                <Setter Target="ChangeSourceFolderButton.(Grid.Row)" Value="1" />
                                                <Setter Target="ActionButtons.Orientation" Value="Vertical" />
                                                <Setter Target="ResultsCounters.Orientation" Value="Vertical" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WorkspaceWide">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="1008" />
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <!-- One bounded native list owns scrolling and virtualization. Its header
         provides context without placing the photo rows in another scroller. -->
                                <ListView x:Name="BatchImageList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="None" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.AutomationId="ProcessingRows">
                                    <ListView.Header>
                                        <StackPanel Spacing="16" Margin="0,0,0,16">
                                            <Border Style="{StaticResource PageIntroBorderStyle}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource SectionIconBadgeStyle}" Background="{ThemeResource JpgSpinnerOrangeIconBackgroundBrush}" VerticalAlignment="Top">
                                                        <SymbolIcon Symbol="Pictures" Foreground="{ThemeResource JpgSpinnerOrangeTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="8">
                                                        <TextBlock x:Uid="Shell_SourceSelectionHeading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind SourceSelectionRegionVisibility, Mode=OneWay}" AutomationProperties.AutomationId="SourceSelectionRegion" />
                                                        <TextBlock x:Uid="Shell_SourceSelectionDescription" Style="{StaticResource SettingsDescriptionTextStyle}" Visibility="{x:Bind SourceSelectionRegionVisibility, Mode=OneWay}" />
                                                        <TextBlock x:Uid="Shell_AnalysisHeading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind AnalysisRegionVisibility, Mode=OneWay}" AutomationProperties.AutomationId="AnalysisStatus" AutomationProperties.LiveSetting="Polite" />
                                                        <TextBlock x:Uid="Shell_AnalysisDescription" Style="{StaticResource SettingsDescriptionTextStyle}" Visibility="{x:Bind AnalysisRegionVisibility, Mode=OneWay}" />
                                                        <TextBlock x:Uid="Shell_ReviewHeading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind ReviewRegionVisibility, Mode=OneWay}" AutomationProperties.AutomationId="ReviewRegion" />
                                                        <TextBlock x:Uid="Shell_ReviewDescription" Style="{StaticResource SettingsDescriptionTextStyle}" Visibility="{x:Bind ReviewRegionVisibility, Mode=OneWay}" />
                                                        <TextBlock x:Uid="Shell_ProcessingHeading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind ProcessingRegionVisibility, Mode=OneWay}" AutomationProperties.AutomationId="ProcessingRegion" AutomationProperties.LiveSetting="Polite" />
                                                        <TextBlock x:Uid="Shell_ProcessingDescription" Style="{StaticResource SettingsDescriptionTextStyle}" Visibility="{x:Bind ProcessingRegionVisibility, Mode=OneWay}" />
                                                        <TextBlock x:Uid="Shell_ResultsHeading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind ResultsRegionVisibility, Mode=OneWay}" AutomationProperties.AutomationId="ResultsRegion" />
                                                        <TextBlock x:Uid="Shell_ResultsDescription" Style="{StaticResource SettingsDescriptionTextStyle}" Visibility="{x:Bind ResultsRegionVisibility, Mode=OneWay}" />
                                                        <TextBlock x:Uid="Shell_RecoveryRequiredHeading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind RecoveryRequiredRegionVisibility, Mode=OneWay}" AutomationProperties.AutomationId="RecoveryRequiredRegion" AutomationProperties.LiveSetting="Assertive" />
                                                        <TextBlock x:Uid="Shell_RecoveryDescription" Style="{StaticResource SettingsDescriptionTextStyle}" Visibility="{x:Bind RecoveryRequiredRegionVisibility, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Grid x:Name="SelectedSourcePanel" ColumnSpacing="12" RowSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition x:Name="SelectedSourceActionColumn" Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock x:Uid="Shell_SelectedFolderLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind ViewModel.SourceFolderDisplayName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="SelectedSourceFolder" />
                                                </StackPanel>
                                                <Button x:Name="ChangeSourceFolderButton" x:Uid="Shell_ChangeSourceFolder" Grid.Column="1" ContentTemplate="{StaticResource WrappingTextContentTemplate}" IsEnabled="{x:Bind CanPickSourceFolder, Mode=OneWay}" Click="SourcePicker_Click" AutomationProperties.AutomationId="ChangeSourceFolder" />
                                            </Grid>
                                            <!-- Closed native InfoBars have zero content height but
                                                 remain in layout. Group them without item spacing. -->
                                            <StackPanel>
                                                <ProgressRing x:Uid="Shell_StartupRecoveryProgress" IsActive="{x:Bind IsStartupRecoveryPending, Mode=OneWay}" Visibility="{x:Bind StartupRecoveryProgressVisibility, Mode=OneWay}" Width="32" Height="32" AutomationProperties.AutomationId="StartupRecoveryProgress" />
                                                <InfoBar x:Uid="Shell_StartupRecoveryError" Severity="Error" IsClosable="False" Message="{x:Bind StartupRecoveryErrorMessage, Mode=OneWay}" IsOpen="{x:Bind HasStartupRecoveryError, Mode=OneWay}" AutomationProperties.AutomationId="StartupRecoveryError" AutomationProperties.LiveSetting="Assertive" />
                                                <Button x:Uid="Shell_RestoreRecoverySource" ContentTemplate="{StaticResource WrappingTextContentTemplate}" IsEnabled="{x:Bind CanRestoreStartupSourceAccess, Mode=OneWay}" Visibility="{x:Bind RecoveryRequiredRegionVisibility, Mode=OneWay}" Click="RestoreRecoverySource_Click" AutomationProperties.AutomationId="RestoreRecoverySource" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind StartupRecoverySummaryVisibility, Mode=OneWay}">
                                                    <TextBlock x:Uid="Shell_StartupRecoveredCount" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind StartupRecoveredTransactionCount, Mode=OneWay}" AutomationProperties.AutomationId="StartupRecoveredTransactionCount" />
                                                </StackPanel>
                                                <InfoBar x:Name="IntegrationErrorBar" Severity="Error" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="IntegrationError" AutomationProperties.LiveSetting="Assertive" />
                                                <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}" AutomationProperties.AutomationId="WorkflowError" AutomationProperties.LiveSetting="Assertive">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind ViewModel.ErrorExplanation, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        <TextBlock Text="{x:Bind ViewModel.ErrorRemedy, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </StackPanel>
                                                </InfoBar>
                                            </StackPanel>
                                            <Grid x:Name="ReviewFactsPanel" ColumnSpacing="12" RowSpacing="12" Visibility="{x:Bind ProcessingRowsRegionVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition x:Name="OutputSummaryColumn" Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{ThemeResource JpgSpinnerVioletSurfaceBrush}" CornerRadius="8" Padding="16">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock x:Uid="Shell_EligibleFilesLabel" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind ViewModel.EligibleFileCountText, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource JpgSpinnerVioletTextBrush}" AutomationProperties.AutomationId="EligibleFileCount" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="OutputSummaryCard" Grid.Column="1" Style="{StaticResource ContentCardBorderStyle}" Padding="16">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock x:Uid="Shell_OutputSummaryHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind OutputDispositionDescription, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="OutputDispositionSummary" />
                                                        <StackPanel x:Name="BackupDestinationPanel" Visibility="{x:Bind BackupDestinationVisibility, Mode=OneWay}" Spacing="4">
                                                            <TextBlock x:Uid="Shell_BackupDestinationLabel" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind ViewModel.BackupRootDisplayPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="BackupDestination" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <InfoBar x:Uid="Shell_NoPlannedCorrections" Severity="Informational" IsClosable="False" IsOpen="{x:Bind HasNoPlannedCorrections, Mode=OneWay}" />
                                            <Expander x:Uid="Shell_ProcessingOptionsSummary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{x:Bind ProcessingSettingsSummary, Mode=OneWay}" Style="{StaticResource SettingsDescriptionTextStyle}" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="EffectiveProcessingSettings" />
                                            </Expander>
                                            <TextBlock x:Uid="Shell_ProcessingRowsLabel" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind ProcessingRowsRegionVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </ListView.Header>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:ImageProcessingRowViewModel">
                                            <Border Style="{StaticResource ContentCardBorderStyle}" Padding="16">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource SectionIconBadgeStyle}" VerticalAlignment="Top">
                                                            <SymbolIcon Symbol="Pictures" Foreground="{ThemeResource JpgSpinnerVioletTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                            <TextBlock Text="{x:Bind StatusDescription, Mode=OneWay}" Style="{StaticResource SettingsDescriptionTextStyle}" IsTextSelectionEnabled="True" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind HasError, Mode=OneWay}" Title="{x:Bind ErrorTitle, Mode=OneWay}">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind ErrorExplanation, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                            <TextBlock Text="{x:Bind ErrorRemedy, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        </StackPanel>
                                                    </InfoBar>
                                                    <!-- Only a destructive plan exposes exact edge amounts and
                             the existing identity-bound acknowledgment command. -->
                                                    <InfoBar x:Uid="Shell_EdgeTrimmingNotice" Severity="Warning" IsClosable="False" IsOpen="{x:Bind HasEdgeTrimming, Mode=OneWay}">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock x:Uid="Shell_DiscardedRightEdgeLabel" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind DiscardedSourceRightEdgeWidthInPixelsText}" AutomationProperties.AutomationId="DiscardedRightEdgePixels" />
                                                            <TextBlock x:Uid="Shell_DiscardedBottomEdgeLabel" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind DiscardedSourceBottomEdgeHeightInPixelsText}" AutomationProperties.AutomationId="DiscardedBottomEdgePixels" />
                                                            <Button x:Uid="Shell_TrimConsent" Content="{x:Bind EdgeTrimmingAcknowledgmentDescription, Mode=OneWay}" ContentTemplate="{StaticResource WrappingTextContentTemplate}" IsEnabled="{x:Bind RequiresEdgeTrimmingAcknowledgment, Mode=OneWay}" AutomationProperties.AutomationId="AcknowledgeEdgeTrimming" Click="TrimConsent_Click" />
                                                        </StackPanel>
                                                    </InfoBar>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.Footer>
                                        <Expander x:Uid="Shell_DiscoveryObservations" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ProcessingRowsRegionVisibility, Mode=OneWay}" AutomationProperties.AutomationId="DiscoveryObservations">
                                            <StackPanel Spacing="12">
                                                <TextBlock x:Uid="Shell_RecursiveExclusionNotice" Style="{StaticResource SettingsDescriptionTextStyle}" />
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.DiscoveryIssues, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="presentation:ImageSourceDiscoveryIssueViewModel">
                                                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                                                <TextBlock Text="{x:Bind RelativePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                <TextBlock Text="{x:Bind KindDescription}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{x:Bind ErrorTitle}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{x:Bind ErrorExplanation}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{x:Bind ErrorRemedy}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </ListView.Footer>
                                </ListView>
                                <!-- Commands remain reachable while the single native photo list scrolls. -->
                                <StackPanel Grid.Row="1" Spacing="8">
