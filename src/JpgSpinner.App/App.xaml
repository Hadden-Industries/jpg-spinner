<Application x:Class="JpgSpinner.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The original owned vector is shared by the interactive logo and
                 background watermark. System colours take precedence in HC. -->
            <ResourceDictionary.MergedDictionaries>
                <!-- Native WinUI styles own material/high-contrast fallbacks. -->
                <controls:XamlControlsResources />
                <ResourceDictionary>
                    <Color x:Key="JpgSpinnerBrandPurpleColor">#140044</Color>
                    <Color x:Key="JpgSpinnerBrandLogoColor">White</Color>
                    <Color x:Key="JpgSpinnerBrandOrangeColor">#F05A29</Color>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Brand tints live on content, with dark text for reading:
                         orange 7.41:1 and violet 9.66:1 on their paired surfaces. -->
                    <SolidColorBrush x:Key="JpgSpinnerOrangeSurfaceBrush" Color="#FFF1E9" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeIconBackgroundBrush" Color="#FFE0CB" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeTextBrush" Color="#8F2E0F" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletSurfaceBrush" Color="#F2EDFF" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletIconBackgroundBrush" Color="#E4D9FF" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletTextBrush" Color="#4B287D" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeBrush" Color="{StaticResource JpgSpinnerBrandOrangeColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerPurpleBrush" Color="{StaticResource JpgSpinnerBrandPurpleColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerFooterForegroundBrush" Color="{StaticResource JpgSpinnerBrandPurpleColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerBrandForegroundBrush" Color="{StaticResource JpgSpinnerBrandLogoColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="JpgSpinnerOrangeSurfaceBrush" Color="#332018" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeIconBackgroundBrush" Color="#4A2B1B" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeTextBrush" Color="#FFC5A8" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletSurfaceBrush" Color="#251D38" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletIconBackgroundBrush" Color="#3A2B55" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletTextBrush" Color="#DAC6FF" />
                    <SolidColorBrush x:Key="JpgSpinnerBrandForegroundBrush" Color="{StaticResource JpgSpinnerBrandLogoColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeBrush" Color="{StaticResource JpgSpinnerBrandOrangeColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerPurpleBrush" Color="{StaticResource JpgSpinnerBrandPurpleColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerFooterForegroundBrush" Color="{StaticResource JpgSpinnerBrandPurpleColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="JpgSpinnerOrangeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeIconBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletIconBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerVioletTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerOrangeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerPurpleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerFooterForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="JpgSpinnerBrandForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="JpgSpinnerLogoTemplate">
                <Viewbox Stretch="Uniform">
                    <Path Width="100" Height="100" Fill="{ThemeResource JpgSpinnerBrandForegroundBrush}" Data="M90.19 79.584l4.018-4.018h0.001c7.722-7.721 7.722-20.242 0-27.963L66.344 19.74  c-7.723-7.723-20.241-7.723-27.963 0c-7.722 7.721-7.722 20.242 0 27.963l0.02 0.02L52.277 61.6l0.02 0.02  c2.575 2.574 2.574 6.748 0 9.32c-2.573 2.574-6.746 2.574-9.319 0L15.113 43.076c-2.574-2.576-2.574-6.748 0-9.322l4.016-4.018  l2.251 2.25l4.866-18.664l-18.681 4.85l2.244 2.244l-4.018 4.018H5.791c-7.722 7.723-7.722 20.24 0 27.961l27.864 27.867  c7.722 7.721 20.242 7.721 27.964 0c7.722-7.723 7.722-20.242 0-27.965l-0.02-0.02L47.723 38.4l-0.02-0.02  c-2.575-2.574-2.575-6.746 0-9.318c2.572-2.576 6.744-2.576 9.319 0l27.864 27.863c2.574 2.574 2.574 6.746 0 9.318l-4.017 4.018  l-2.25-2.248l-4.866 18.664l18.68-4.852L90.19 79.584z" />
                </Viewbox>
            </DataTemplate>
            <!-- Controlled localized string content may wrap without a fixed
                 height; no text shortening or bespoke button template. -->
            <DataTemplate x:Key="WrappingTextContentTemplate">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
            <!-- Native theme brushes preserve light/dark/high-contrast and
                 transparency preferences. Glass is reserved for navigation;
                 these content surfaces use the Windows Mica card pattern.
                 https://learn.microsoft.com/windows/apps/design/style/mica -->
            <Style x:Key="ContentCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="SettingsDescriptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="PrivacyParagraphTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LineHeight" Value="24" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="PrivacySectionHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{ThemeResource JpgSpinnerVioletTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="PageIntroHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource JpgSpinnerOrangeTextBrush}" />
            </Style>
            <Style x:Key="PageIntroBorderStyle" TargetType="Border" BasedOn="{StaticResource ContentCardBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource JpgSpinnerOrangeSurfaceBrush}" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="SectionIconBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="{ThemeResource JpgSpinnerVioletIconBackgroundBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
