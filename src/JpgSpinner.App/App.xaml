<Application
    x:Class="JpgSpinner.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Native WinUI styles own material/high-contrast fallbacks. -->
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <!-- Controlled localized string content may wrap without a fixed
                 height; no text shortening or bespoke button template. -->
            <DataTemplate x:Key="WrappingTextContentTemplate">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
