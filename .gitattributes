# Repository-wide line ending enforcement (supersedes local core.autocrlf)
# - Auto-detect text vs binary files
# - Normalise text files to LF on commit and keep LF on checkout
* text=auto eol=lf

# Native installed notices are retained byte-for-byte, including upstream CRLF.
# They are vendor assets, not first-party prose to normalize during checkout.
docs/licenses/native/*.copyright.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# NuGet notice payloads likewise preserve vendor BOMs, endings and whitespace.
docs/licenses/nuget/*.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Unified patches retain upstream context verbatim: the context prefix before
# a tab and blank context lines are patch syntax, not first-party indentation.
# Keep all other whitespace checks and normal source-file checks unchanged.
vcpkg-ports/**/*.patch whitespace=-blank-at-eol,-space-before-tab
